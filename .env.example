# ==========================================
# TELEGRAM DAILY PRODUCTIVITY & NEWS BOT CONFIG
# ==========================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram ID of Bot Owner (from @userinfobot)
TELEGRAM_OWNER_ID=

# Additional Admin Telegram User IDs (comma-separated, optional)
ADMIN_TELEGRAM_IDS=

# Database Configuration (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# Timezone (Default: Asia/Kolkata - Indian Standard Time)
TIMEZONE=Asia/Kolkata

# Environment (production or development)
ENVIRONMENT=production

# Scheduled Notification Times (24h HH:MM format)
NEWS_TIME=07:00
MORNING_TIME=08:00
VIDEO_REMINDER_TIME=10:00

STUDY_REMINDER_TIME=14:00
EXERCISE_REMINDER_TIME=18:00
EOD_TIME=21:00

# Productivity & Scoring Settings
STREAK_THRESHOLD=70.0
MISSED_REMINDERS_ENABLED=true
BREAKING_NEWS_ENABLED=true
MORNING_COMBINED_ENABLED=false
NEWS_LANGUAGE=en

# LLM Providers for Summarization / Reasoning (At least one recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
NEWS_API_KEY=

# Application Logging
LOG_LEVEL=INFO
TELEGRAM_POLLING=true
